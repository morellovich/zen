{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth/src",
  "prefix": "zen",
  "projectType": "library",
  "tags": ["scope:frontend", "type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/auth/jest.config.ts",
        "tsConfig": "libs/auth/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "options": {
        "port": 4401,
        "styles": ["apps/portal/src/styles.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "options": {
        "outputDir": "dist/storybook/auth",
        "styles": ["apps/portal/src/styles.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "options": {
        "command": "test-storybook -c .storybook --url=http://localhost:4401"
      }
    },
    "static-storybook": {
      "options": {
        "staticFilePath": "dist/storybook/auth"
      }
    }
  }
}
