  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "importSort": {
    ".js, .ts, .jsx, .tsx, .mjs, .mts, .cjs, .cts": {
      "style": "module",
      "parser": "typescript"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-yarn"
  }
