{
  "name": "@zen/source",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "preinstall": "node -e \"if (!/pnpm/.test(process.env.npm_config_user_agent || '')) { console.error('\\x1b[31m\\n[Zen Security] Error: This repository strictly requires pnpm. Do not use npm or yarn.\\nRun: pnpm install\\n\\x1b[0m'); process.exit(1); }\"",
    "start": "nx serve portal",
    "start:api": "nx serve api",
    "cap:add:android": "cap add android",
    "cap:run:android": "nx build portal && cap sync && cap open android",
    "cap:add:ios": "cap add ios",
    "cap:run:ios": "nx build portal && cap sync && cap open ios",
    "e2e:portal": "nx e2e portal-e2e --ui",
    "e2e:api": "nx e2e api-e2e",
    "gen:frontend": "graphql-codegen -c tools/apollo-angular.yml && graphql-codegen -c tools/apollo-possible-types.yml",
    "gen:logos": "ts-node --project tools/tsconfig.json tools/fetch-svgl.ts",
    "gen:api": "prisma generate --schema apps/api/prisma/schema.prisma && ts-node --project tools/tsconfig.json tools/generate.ts",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma && ts-node --project tools/tsconfig.json tools/generate.ts",
    "prisma:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "prod:portal": "nx build portal --prod",
    "prod:api": "nx build api --prod && docker build -f deploy/api/Dockerfile -t zen-api .",
    "docker:run:api": "docker run -d --name zen-api -p 9080:7080 -p 9081:7081 zen-api",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "nx format:write --all"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@as-integrations/fastify": "^2.1.1",
    "@casl/ability": "~6.7.5",
